---
import "../styles/global.css";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sam Lau — Design Prototypes</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen bg-[#fafaf8] flex items-center justify-center px-6" style="font-family: 'Newsreader', serif;">
  <main class="max-w-md w-full py-20">
    <h1 class="text-3xl font-medium text-[#1a1a1a] mb-2">Sam Lau</h1>
    <p class="text-[#666] text-lg mb-12">Eight homepage prototypes.</p>
    <nav class="space-y-4">
      <a href="/1" class="group flex items-baseline gap-4 py-3 border-b border-[#e5e5e5] hover:border-[#1a1a1a] transition-colors">
        <span class="text-sm text-[#999] group-hover:text-[#1a1a1a] transition-colors tabular-nums">01</span>
        <span class="text-xl text-[#1a1a1a]">The Broadsheet</span>
        <span class="text-sm text-[#999] ml-auto">editorial</span>
      </a>
      <a href="/2" class="group flex items-baseline gap-4 py-3 border-b border-[#e5e5e5] hover:border-[#1a1a1a] transition-colors">
        <span class="text-sm text-[#999] group-hover:text-[#1a1a1a] transition-colors tabular-nums">02</span>
        <span class="text-xl text-[#1a1a1a]">The Catalog</span>
        <span class="text-sm text-[#999] ml-auto">archival</span>
      </a>
      <a href="/3" class="group flex items-baseline gap-4 py-3 border-b border-[#e5e5e5] hover:border-[#1a1a1a] transition-colors">
        <span class="text-sm text-[#999] group-hover:text-[#1a1a1a] transition-colors tabular-nums">03</span>
        <span class="text-xl text-[#1a1a1a]">The Folio</span>
        <span class="text-sm text-[#999] ml-auto">magazine</span>
      </a>
      <a href="/4" class="group flex items-baseline gap-4 py-3 border-b border-[#e5e5e5] hover:border-[#1a1a1a] transition-colors">
        <span class="text-sm text-[#999] group-hover:text-[#1a1a1a] transition-colors tabular-nums">04</span>
        <span class="text-xl text-[#1a1a1a]">The Bento</span>
        <span class="text-sm text-[#999] ml-auto">grid</span>
      </a>
      <a href="/5" class="group flex items-baseline gap-4 py-3 border-b border-[#e5e5e5] hover:border-[#1a1a1a] transition-colors">
        <span class="text-sm text-[#999] group-hover:text-[#1a1a1a] transition-colors tabular-nums">05</span>
        <span class="text-xl text-[#1a1a1a]">The Margin</span>
        <span class="text-sm text-[#999] ml-auto">tufte</span>
      </a>
      <a href="/6" class="group flex items-baseline gap-4 py-3 border-b border-[#e5e5e5] hover:border-[#1a1a1a] transition-colors">
        <span class="text-sm text-[#999] group-hover:text-[#1a1a1a] transition-colors tabular-nums">06</span>
        <span class="text-xl text-[#1a1a1a]">The Resume</span>
        <span class="text-sm text-[#999] ml-auto">solomenko</span>
      </a>
      <a href="/7" class="group flex items-baseline gap-4 py-3 border-b border-[#e5e5e5] hover:border-[#1a1a1a] transition-colors">
        <span class="text-sm text-[#999] group-hover:text-[#1a1a1a] transition-colors tabular-nums">07</span>
        <span class="text-xl text-[#1a1a1a]">The Sidebar</span>
        <span class="text-sm text-[#999] ml-auto">bradley</span>
      </a>
      <a href="/8" class="group flex items-baseline gap-4 py-3 border-b border-[#e5e5e5] hover:border-[#1a1a1a] transition-colors">
        <span class="text-sm text-[#999] group-hover:text-[#1a1a1a] transition-colors tabular-nums">08</span>
        <span class="text-xl text-[#1a1a1a]">The Timeline</span>
        <span class="text-sm text-[#999] ml-auto">pi</span>
      </a>
    </nav>
  </main>
</body>
</html>
