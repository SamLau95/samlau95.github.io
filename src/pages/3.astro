---
import "../styles/global.css";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sam Lau — UC San Diego</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Karla:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="folio-body">
  <!-- Hero -->
  <header class="folio-hero">
    <div class="hero-inner">
      <div class="hero-label">Halıcıoğlu Data Science Institute, UC San Diego</div>
      <h1 class="hero-name">Sam<br/>Lau</h1>
      <div class="hero-role">Assistant Teaching Professor</div>
    </div>
    <div class="hero-photo-wrap">
      <img src="/sam_lau_headshot_small.JPG" alt="Sam Lau" class="hero-photo" />
    </div>
  </header>

  <main class="folio-main">
    <!-- Bio -->
    <section class="folio-section bio-section">
      <div class="section-marker">About</div>
      <div class="bio-content">
        <p class="bio-lead">
          Sam Lau applies methods from human-computer interaction
          to design software tools for education.
        </p>
        <p>
          He authored <em>Learning Data Science</em>, published by
          O'Reilly Media in 2023.
        </p>
      </div>
      <nav class="bio-links">
        <a href="mailto:lau@ucsd.edu">lau@ucsd.edu</a>
        <a href="https://github.com/samlau95">GitHub</a>
        <a href="https://twitter.com/samlau95">Twitter</a>
        <a href="/cv">CV</a>
        <a href="https://dstl-lab.github.io/">DSTL Lab</a>
      </nav>
    </section>

    <!-- Projects -->
    <section class="folio-section">
      <div class="section-marker">Projects</div>
      <div class="project-card">
        <h3 class="project-title"><a href="https://pandastutor.com/">Pandas Tutor</a></h3>
        <p>Makes step-by-step diagrams showing how Python pandas code transforms data.</p>
        <a href="https://www.youtube.com/watch?v=_vPmMYSGAlU" class="project-podcast">Listen to the podcast →</a>
      </div>
    </section>

    <!-- News -->
    <section class="folio-section">
      <div class="section-marker">News</div>
      <p class="news-text">
        Attending SIGCSE 2026 with sessions on teaching CS with AI and
        student presentations on skill tests and practice problems.
      </p>
    </section>

    <!-- Publications -->
    <section class="folio-section pubs-section">
      <div class="section-marker">Publications</div>
      <div class="pubs-grid">
        <article class="pub-item">
          <span class="pub-year">2026</span>
          <div>
            <div class="pub-title">Barriers that Programming Instructors Face While Performing Emergency Pedagogical Design to Shape Student-AI Interactions with Generative AI Tools</div>
            <div class="pub-venue">CHI</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2026</span>
          <div>
            <div class="pub-title">Improving LLM-Generated Educational Content</div>
            <div class="pub-venue">SIGCSE</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2026</span>
          <div>
            <div class="pub-title">Designing and Implementing Skill Tests at Scale</div>
            <div class="pub-venue">SIGCSE</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2025</span>
          <div>
            <div class="pub-title">The Design Space of LLM-Based AI Coding Assistants</div>
            <div class="pub-venue">VL/HCC</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2025</span>
          <div>
            <div class="pub-title">"I'm not sure, but…": Expert Practices</div>
            <div class="pub-venue">SIGCSE</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2025</span>
          <div>
            <div class="pub-title">How Novices Use Program Visualizations</div>
            <div class="pub-venue">SIGCSE</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2025</span>
          <div>
            <div class="pub-title">Beyond the Hype: Generative AI Review</div>
            <div class="pub-venue">ITiCSE</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2023</span>
          <div>
            <div class="pub-title">From Ban It Till We Understand It</div>
            <div class="pub-venue">ICER</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2023</span>
          <div>
            <div class="pub-title">Teaching Data Science by Visualizing Data Table Transformations</div>
            <div class="pub-venue">DataEd</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2022</span>
          <div>
            <div class="pub-title">Codehound: Helping Instructors Track Pedagogical Code Dependencies</div>
            <div class="pub-venue">SPLASH-E</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2022</span>
          <div>
            <div class="pub-title">The Challenges of Evolving Technical Courses at Scale</div>
            <div class="pub-venue">L@S</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2022</span>
          <div>
            <div class="pub-title">How Computer Science and Statistics Instructors Approach Data Science</div>
            <div class="pub-venue">SIGCSE</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2021</span>
          <div>
            <div class="pub-title">TweakIt: Supporting End-User Programmers</div>
            <div class="pub-venue">CHI</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2020</span>
          <div>
            <div class="pub-title">The Design Space of Computational Notebooks</div>
            <div class="pub-venue">VL/HCC</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2020</span>
          <div>
            <div class="pub-title">Data Theater: Live Programming Environment</div>
            <div class="pub-venue">LIVE</div>
          </div>
        </article>
        <article class="pub-item">
          <span class="pub-year">2019</span>
          <div>
            <div class="pub-title">Experiment Reconstruction Reduces Fixation</div>
            <div class="pub-venue">C&amp;C</div>
          </div>
        </article>
      </div>
    </section>

    <!-- Teaching -->
    <section class="folio-section">
      <div class="section-marker">Teaching</div>
      <div class="teaching-list">
        <div class="teaching-group">
          <div class="teaching-school">UC San Diego</div>
          <div class="teaching-item">
            <span class="teaching-code">DSC 80</span>
            <span>Practice and Application of Data Science</span>
            <span class="teaching-terms">Fall 24, Spring 24, Fall 23</span>
          </div>
          <div class="teaching-item">
            <span class="teaching-code">DSC 106</span>
            <span>Data Visualization</span>
            <span class="teaching-terms">Winter 24</span>
          </div>
        </div>
        <div class="teaching-group">
          <div class="teaching-school">UC Berkeley</div>
          <div class="teaching-item">
            <span class="teaching-code">Data 100</span>
            <span>Principles and Techniques of Data Science</span>
            <span class="teaching-terms">Summer 19</span>
          </div>
          <div class="teaching-item">
            <span class="teaching-code">Data 8</span>
            <span>Foundations of Data Science</span>
            <span class="teaching-terms">Summer 17</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</body>
</html>

<style>
  .folio-body {
    background: #fcfbf8;
    color: #1a1a1a;
    font-family: 'Karla', sans-serif;
    line-height: 1.6;
  }

  /* Hero */
  .folio-hero {
    background: #1a3c34;
    color: #f0ece4;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    padding: 4rem 3rem 0;
    max-width: 1100px;
    margin: 0 auto;
    overflow: hidden;
    animation: heroReveal 0.7s ease-out both;
  }

  @keyframes heroReveal {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-inner {
    padding-bottom: 3rem;
  }

  .hero-label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-bottom: 1.5rem;
  }

  .hero-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .hero-role {
    font-size: 1.1rem;
    opacity: 0.7;
    font-weight: 400;
  }

  .hero-photo-wrap {
    width: clamp(160px, 20vw, 260px);
    align-self: end;
  }

  .hero-photo {
    width: 100%;
    display: block;
    filter: grayscale(20%);
    mix-blend-mode: luminosity;
  }

  /* Main */
  .folio-main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 3rem 4rem;
  }

  /* Sections */
  .folio-section {
    padding: 2.5rem 0;
    border-bottom: 1px solid #e0ddd6;
    animation: sectionIn 0.6s ease-out both;
  }

  .folio-section:nth-child(1) { animation-delay: 0.1s; }
  .folio-section:nth-child(2) { animation-delay: 0.15s; }
  .folio-section:nth-child(3) { animation-delay: 0.2s; }
  .folio-section:nth-child(4) { animation-delay: 0.25s; }
  .folio-section:nth-child(5) { animation-delay: 0.3s; }

  @keyframes sectionIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .section-marker {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1a3c34;
    margin-bottom: 1rem;
  }

  /* Bio */
  .bio-section {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 2rem;
    align-items: start;
  }

  .bio-lead {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }

  .bio-lead + p {
    color: #555;
  }

  .bio-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.85rem;
  }

  .bio-links a {
    color: #1a3c34;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .bio-links a:hover {
    border-bottom-color: #1a3c34;
  }

  /* Projects */
  .project-card {
    padding: 1.25rem 1.5rem;
    border: 1px solid #d8d5ce;
    max-width: 500px;
  }

  .project-title a {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: #1a3c34;
    text-decoration: none;
  }

  .project-title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-card p {
    color: #555;
    margin-top: 0.35rem;
    font-size: 0.9rem;
  }

  .project-podcast {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.82rem;
    color: #1a3c34;
    text-decoration: none;
  }

  .project-podcast:hover {
    text-decoration: underline;
  }

  /* News */
  .news-text {
    max-width: 600px;
    color: #444;
  }

  /* Publications */
  .pubs-grid {
    display: flex;
    flex-direction: column;
  }

  .pub-item {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid #eeebe4;
    align-items: baseline;
    transition: background 0.15s;
  }

  .pub-item:hover {
    background: #f5f3ee;
  }

  .pub-year {
    font-size: 0.8rem;
    color: #999;
    font-variant-numeric: tabular-nums;
  }

  .pub-title {
    font-size: 0.9rem;
    color: #2a2a2a;
  }

  .pub-venue {
    font-size: 0.75rem;
    color: #1a3c34;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-top: 0.15rem;
  }

  /* Teaching */
  .teaching-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .teaching-school {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 700;
    font-size: 1.1rem;
    color: #1a3c34;
    margin-bottom: 0.75rem;
  }

  .teaching-item {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.5rem;
    font-size: 0.88rem;
  }

  .teaching-code {
    font-weight: 600;
  }

  .teaching-terms {
    color: #888;
    font-size: 0.8rem;
    width: 100%;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .folio-hero {
      grid-template-columns: 1fr;
      padding: 3rem 1.5rem 0;
    }
    .hero-photo-wrap {
      width: 140px;
      margin-top: 1.5rem;
    }
    .hero-inner {
      padding-bottom: 1.5rem;
    }
    .folio-main {
      padding: 0 1.5rem 3rem;
    }
    .bio-section {
      grid-template-columns: 1fr;
    }
    .teaching-list {
      grid-template-columns: 1fr;
    }
  }
</style>
