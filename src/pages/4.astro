---
import "../styles/global.css";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sam Lau — UC San Diego</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="bento-body">
  <div class="bento-container">
    <!-- Bento Grid -->
    <div class="bento-grid">
      <!-- Name Card (wide) -->
      <div class="bento-card card-name">
        <div class="card-name-label">Assistant Teaching Professor</div>
        <h1 class="card-name-title">Sam Lau</h1>
        <div class="card-name-dept">Halıcıoğlu Data Science Institute<br/>UC San Diego</div>
      </div>

      <!-- Photo Card -->
      <div class="bento-card card-photo">
        <img src="/sam_lau_headshot_small.JPG" alt="Sam Lau" />
      </div>

      <!-- Bio Card -->
      <div class="bento-card card-bio">
        <p>Applies methods from <strong>human-computer interaction</strong> to design software tools for education.</p>
        <p>Author of <em>Learning Data Science</em> (O'Reilly, 2023).</p>
      </div>

      <!-- Links Card -->
      <div class="bento-card card-links">
        <a href="mailto:lau@ucsd.edu">lau@ucsd.edu</a>
        <a href="https://github.com/samlau95">GitHub</a>
        <a href="https://twitter.com/samlau95">Twitter</a>
        <a href="/cv">CV</a>
        <a href="https://dstl-lab.github.io/">DSTL Lab</a>
      </div>

      <!-- Project Card -->
      <div class="bento-card card-project">
        <div class="project-label">Project</div>
        <h3 class="project-name"><a href="https://pandastutor.com/">Pandas Tutor</a></h3>
        <p>Step-by-step diagrams showing how pandas code transforms data.</p>
        <a href="https://www.youtube.com/watch?v=_vPmMYSGAlU" class="project-link">podcast →</a>
      </div>

      <!-- News Card -->
      <div class="bento-card card-news">
        <div class="news-label">News</div>
        <p>Attending <strong>SIGCSE 2026</strong> — sessions on teaching CS with AI, student presentations on skill tests and practice problems.</p>
      </div>

      <!-- Publications Card (large) -->
      <div class="bento-card card-pubs">
        <div class="pubs-header">
          <h2>Publications</h2>
          <span class="pubs-count">16 papers</span>
        </div>
        <div class="pubs-list">
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">Barriers that Programming Instructors Face While Performing Emergency Pedagogical Design to Shape Student-AI Interactions with Generative AI Tools</span>
            <span class="pub-meta">CHI 2026</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">Improving LLM-Generated Educational Content</span>
            <span class="pub-meta">SIGCSE 2026</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">Designing and Implementing Skill Tests at Scale</span>
            <span class="pub-meta">SIGCSE 2026</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">The Design Space of LLM-Based AI Coding Assistants</span>
            <span class="pub-meta">VL/HCC 2025</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">"I'm not sure, but…": Expert Practices</span>
            <span class="pub-meta">SIGCSE 2025</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">How Novices Use Program Visualizations</span>
            <span class="pub-meta">SIGCSE 2025</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">Beyond the Hype: Generative AI Review</span>
            <span class="pub-meta">ITiCSE 2025</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">From Ban It Till We Understand It</span>
            <span class="pub-meta">ICER 2023</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">Teaching Data Science by Visualizing Data Table Transformations</span>
            <span class="pub-meta">DataEd 2023</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">Codehound: Helping Instructors Track Pedagogical Code Dependencies</span>
            <span class="pub-meta">SPLASH-E 2022</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">The Challenges of Evolving Technical Courses at Scale</span>
            <span class="pub-meta">L@S 2022</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">How Computer Science and Statistics Instructors Approach Data Science</span>
            <span class="pub-meta">SIGCSE 2022</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">TweakIt: Supporting End-User Programmers</span>
            <span class="pub-meta">CHI 2021</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">The Design Space of Computational Notebooks</span>
            <span class="pub-meta">VL/HCC 2020</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">Data Theater: Live Programming Environment</span>
            <span class="pub-meta">LIVE 2020</span>
          </div>
          <div class="pub-entry">
            <span class="pub-dot"></span>
            <span class="pub-title">Experiment Reconstruction Reduces Fixation</span>
            <span class="pub-meta">C&amp;C 2019</span>
          </div>
        </div>
      </div>

      <!-- Teaching Card -->
      <div class="bento-card card-teaching">
        <h2>Teaching</h2>
        <div class="teaching-entries">
          <div class="teaching-entry">
            <div class="teaching-code">DSC 80</div>
            <div class="teaching-name">Practice and Application of Data Science</div>
            <div class="teaching-detail">UCSD · F24, S24, F23</div>
          </div>
          <div class="teaching-entry">
            <div class="teaching-code">DSC 106</div>
            <div class="teaching-name">Data Visualization</div>
            <div class="teaching-detail">UCSD · W24</div>
          </div>
          <div class="teaching-entry">
            <div class="teaching-code">Data 100</div>
            <div class="teaching-name">Principles and Techniques of Data Science</div>
            <div class="teaching-detail">UC Berkeley · Su19</div>
          </div>
          <div class="teaching-entry">
            <div class="teaching-code">Data 8</div>
            <div class="teaching-name">Foundations of Data Science</div>
            <div class="teaching-detail">UC Berkeley · Su17</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>

<style>
  .bento-body {
    background: #f5f4f0;
    color: #1c1917;
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    line-height: 1.55;
  }

  .bento-container {
    max-width: 1060px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  /* Grid */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    animation: gridIn 0.5s ease-out both;
  }

  @keyframes gridIn {
    from { opacity: 0; transform: scale(0.98); }
    to { opacity: 1; transform: scale(1); }
  }

  .bento-card {
    background: #fff;
    border: 1px solid #e5e2db;
    border-radius: 12px;
    padding: 1.25rem;
    transition: box-shadow 0.25s, transform 0.25s;
  }

  .bento-card:hover {
    box-shadow: 0 8px 30px rgba(0,0,0,0.06);
    transform: translateY(-2px);
  }

  /* Name card */
  .card-name {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 1.5rem;
  }

  .card-name-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #7c2d36;
    margin-bottom: 0.5rem;
  }

  .card-name-title {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .card-name-dept {
    font-size: 0.88rem;
    color: #777;
    line-height: 1.4;
  }

  /* Photo card */
  .card-photo {
    grid-column: span 2;
    grid-row: span 2;
    padding: 0;
    overflow: hidden;
  }

  .card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 11px;
  }

  /* Bio card */
  .card-bio {
    grid-column: span 2;
    font-size: 0.95rem;
    color: #444;
  }

  .card-bio p {
    margin-bottom: 0.5rem;
  }

  .card-bio strong {
    color: #1c1917;
    font-weight: 500;
  }

  .card-bio em {
    color: #7c2d36;
  }

  /* Links card */
  .card-links {
    grid-column: span 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
  }

  .card-links a {
    color: #1c1917;
    text-decoration: none;
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
  }

  .card-links a:hover {
    background: #7c2d36;
    color: #fff;
  }

  /* Project card */
  .card-project {
    grid-column: span 1;
  }

  .project-label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #aaa;
    margin-bottom: 0.5rem;
  }

  .project-name {
    font-family: 'Fraunces', serif;
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .project-name a {
    color: #1c1917;
    text-decoration: none;
  }

  .project-name a:hover {
    color: #7c2d36;
  }

  .card-project p {
    font-size: 0.82rem;
    color: #666;
  }

  .project-link {
    font-size: 0.78rem;
    color: #7c2d36;
    text-decoration: none;
    display: inline-block;
    margin-top: 0.5rem;
  }

  /* News card */
  .card-news {
    grid-column: span 2;
  }

  .news-label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #aaa;
    margin-bottom: 0.5rem;
  }

  .card-news p {
    font-size: 0.9rem;
    color: #555;
  }

  .card-news strong {
    color: #7c2d36;
    font-weight: 600;
  }

  /* Publications card */
  .card-pubs {
    grid-column: span 3;
    grid-row: span 1;
  }

  .pubs-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .pubs-header h2 {
    font-family: 'Fraunces', serif;
    font-size: 1.3rem;
    font-weight: 700;
  }

  .pubs-count {
    font-size: 0.75rem;
    color: #999;
  }

  .pub-entry {
    display: grid;
    grid-template-columns: 6px 1fr auto;
    gap: 0.75rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid #f0ede8;
    align-items: baseline;
    font-size: 0.82rem;
  }

  .pub-entry:last-child {
    border-bottom: none;
  }

  .pub-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #7c2d36;
    margin-top: 0.45rem;
    flex-shrink: 0;
  }

  .pub-title {
    color: #333;
  }

  .pub-meta {
    color: #999;
    font-size: 0.75rem;
    white-space: nowrap;
  }

  /* Teaching card */
  .card-teaching {
    grid-column: span 1;
  }

  .card-teaching h2 {
    font-family: 'Fraunces', serif;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .teaching-entries {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .teaching-entry {
    padding-bottom: 0.65rem;
    border-bottom: 1px solid #f0ede8;
  }

  .teaching-entry:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .teaching-code {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: #7c2d36;
  }

  .teaching-name {
    font-size: 0.82rem;
    color: #444;
  }

  .teaching-detail {
    font-size: 0.72rem;
    color: #999;
    margin-top: 0.1rem;
  }

  /* Responsive */
  @media (max-width: 800px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .card-pubs {
      grid-column: span 2;
    }
  }

  @media (max-width: 500px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
    .card-name, .card-photo, .card-bio, .card-news, .card-pubs {
      grid-column: span 1;
    }
  }
</style>
