---
import "../styles/global.css";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sam Lau — UC San Diego</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body class="catalog-body">
  <div class="catalog-page">
    <!-- Header bar -->
    <header class="catalog-header">
      <div class="header-id">HDSI / UCSD</div>
      <div class="header-ref">REF: LAU-2026</div>
    </header>

    <!-- Title block -->
    <div class="catalog-title-block">
      <div class="title-label">FACULTY RECORD</div>
      <h1 class="title-name">SAM LAU</h1>
      <div class="title-meta">
        <span>Assistant Teaching Professor</span>
        <span class="meta-sep">/</span>
        <span>Halıcıoğlu Data Science Institute</span>
      </div>
    </div>

    <!-- Main grid -->
    <div class="catalog-grid">
      <!-- Sidebar -->
      <aside class="catalog-sidebar">
        <img src="/sam_lau_headshot_small.JPG" alt="Sam Lau" class="sidebar-photo" />

        <div class="sidebar-section">
          <div class="sidebar-label">CONTACT</div>
          <a href="mailto:lau@ucsd.edu" class="sidebar-link">lau@ucsd.edu</a>
          <a href="https://github.com/samlau95" class="sidebar-link">github/samlau95</a>
          <a href="https://twitter.com/samlau95" class="sidebar-link">@samlau95</a>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-label">LINKS</div>
          <a href="/cv" class="sidebar-link">Curriculum Vitae →</a>
          <a href="https://dstl-lab.github.io/" class="sidebar-link">DSTL Lab →</a>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-label">UPDATED</div>
          <div class="sidebar-text">Feb 2026</div>
        </div>
      </aside>

      <!-- Main content -->
      <main class="catalog-main">
        <!-- About -->
        <section class="catalog-section">
          <div class="section-code">01 — ABOUT</div>
          <p class="about-text">
            Applies methods from human-computer interaction to design software
            tools for education. Author of <em>Learning Data Science</em>
            (O'Reilly Media, 2023).
          </p>
        </section>

        <!-- Projects -->
        <section class="catalog-section">
          <div class="section-code">02 — PROJECTS</div>
          <div class="project-entry">
            <div class="project-name"><a href="https://pandastutor.com/">Pandas Tutor</a></div>
            <div class="project-desc">Step-by-step diagrams showing how pandas code transforms data. <a href="https://www.youtube.com/watch?v=_vPmMYSGAlU">[podcast]</a></div>
          </div>
        </section>

        <!-- News -->
        <section class="catalog-section">
          <div class="section-code">03 — NEWS</div>
          <p>Attending SIGCSE 2026 — sessions on teaching CS with AI, student presentations on skill tests and practice problems.</p>
        </section>

        <!-- Publications -->
        <section class="catalog-section">
          <div class="section-code">04 — PUBLICATIONS</div>
          <div class="pub-table">
            <div class="pub-row">
              <span class="pub-year">2026</span>
              <span class="pub-text">Barriers that Programming Instructors Face While Performing Emergency Pedagogical Design to Shape Student-AI Interactions with Generative AI Tools</span>
              <span class="pub-venue">CHI</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2026</span>
              <span class="pub-text">Improving LLM-Generated Educational Content</span>
              <span class="pub-venue">SIGCSE</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2026</span>
              <span class="pub-text">Designing and Implementing Skill Tests at Scale</span>
              <span class="pub-venue">SIGCSE</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2025</span>
              <span class="pub-text">The Design Space of LLM-Based AI Coding Assistants</span>
              <span class="pub-venue">VL/HCC</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2025</span>
              <span class="pub-text">"I'm not sure, but…": Expert Practices</span>
              <span class="pub-venue">SIGCSE</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2025</span>
              <span class="pub-text">How Novices Use Program Visualizations</span>
              <span class="pub-venue">SIGCSE</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2025</span>
              <span class="pub-text">Beyond the Hype: Generative AI Review</span>
              <span class="pub-venue">ITiCSE</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2023</span>
              <span class="pub-text">From Ban It Till We Understand It</span>
              <span class="pub-venue">ICER</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2023</span>
              <span class="pub-text">Teaching Data Science by Visualizing Data Table Transformations</span>
              <span class="pub-venue">DataEd</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2022</span>
              <span class="pub-text">Codehound: Helping Instructors Track Pedagogical Code Dependencies</span>
              <span class="pub-venue">SPLASH-E</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2022</span>
              <span class="pub-text">The Challenges of Evolving Technical Courses at Scale</span>
              <span class="pub-venue">L@S</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2022</span>
              <span class="pub-text">How Computer Science and Statistics Instructors Approach Data Science</span>
              <span class="pub-venue">SIGCSE</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2021</span>
              <span class="pub-text">TweakIt: Supporting End-User Programmers</span>
              <span class="pub-venue">CHI</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2020</span>
              <span class="pub-text">The Design Space of Computational Notebooks</span>
              <span class="pub-venue">VL/HCC</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2020</span>
              <span class="pub-text">Data Theater: Live Programming Environment</span>
              <span class="pub-venue">LIVE</span>
            </div>
            <div class="pub-row">
              <span class="pub-year">2019</span>
              <span class="pub-text">Experiment Reconstruction Reduces Fixation</span>
              <span class="pub-venue">C&amp;C</span>
            </div>
          </div>
        </section>

        <!-- Teaching -->
        <section class="catalog-section">
          <div class="section-code">05 — TEACHING</div>
          <div class="teaching-table">
            <div class="teaching-row">
              <span class="teaching-inst">UCSD</span>
              <span class="teaching-course">DSC 80 — Practice and Application of Data Science</span>
              <span class="teaching-when">F24, S24, F23</span>
            </div>
            <div class="teaching-row">
              <span class="teaching-inst">UCSD</span>
              <span class="teaching-course">DSC 106 — Data Visualization</span>
              <span class="teaching-when">W24</span>
            </div>
            <div class="teaching-row">
              <span class="teaching-inst">UCB</span>
              <span class="teaching-course">Data 100 — Principles and Techniques of Data Science</span>
              <span class="teaching-when">Su19</span>
            </div>
            <div class="teaching-row">
              <span class="teaching-inst">UCB</span>
              <span class="teaching-course">Data 8 — Foundations of Data Science</span>
              <span class="teaching-when">Su17</span>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>
</body>
</html>

<style>
  .catalog-body {
    background: #0c1222;
    color: #c8c8c8;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    line-height: 1.65;
  }

  .catalog-page {
    max-width: 980px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    animation: catalogIn 0.5s ease-out both;
  }

  @keyframes catalogIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Header */
  .catalog-header {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #1e2d4a;
    margin-bottom: 2rem;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: #4a6a8a;
  }

  /* Title Block */
  .catalog-title-block {
    margin-bottom: 2.5rem;
  }

  .title-label {
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    color: #d4a574;
    margin-bottom: 0.5rem;
  }

  .title-name {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #e8e0d4;
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .title-meta {
    color: #6a7a8a;
    font-size: 0.8rem;
  }

  .meta-sep {
    margin: 0 0.5rem;
    color: #2a3a4a;
  }

  /* Grid */
  .catalog-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
  }

  /* Sidebar */
  .sidebar-photo {
    width: 100%;
    filter: grayscale(100%) sepia(30%) brightness(0.8);
    margin-bottom: 1.5rem;
  }

  .sidebar-section {
    margin-bottom: 1.5rem;
  }

  .sidebar-label {
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    color: #d4a574;
    margin-bottom: 0.35rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid #1e2d4a;
  }

  .sidebar-link {
    display: block;
    color: #8a9aaa;
    text-decoration: none;
    padding: 0.15rem 0;
    transition: color 0.2s;
  }

  .sidebar-link:hover {
    color: #d4a574;
  }

  .sidebar-text {
    color: #6a7a8a;
  }

  /* Main */
  .catalog-section {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #1a2538;
  }

  .section-code {
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    color: #d4a574;
    margin-bottom: 0.75rem;
  }

  .about-text {
    font-size: 0.95rem;
    color: #d8d0c8;
    line-height: 1.7;
  }

  .about-text em {
    color: #d4a574;
    font-style: italic;
  }

  /* Projects */
  .project-entry {
    padding: 0.75rem;
    border: 1px solid #1e2d4a;
    margin-bottom: 0.5rem;
  }

  .project-name a {
    color: #e8e0d4;
    text-decoration: none;
    font-weight: 500;
  }

  .project-name a:hover {
    color: #d4a574;
  }

  .project-desc {
    color: #7a8a9a;
    margin-top: 0.25rem;
    font-size: 0.8rem;
  }

  .project-desc a {
    color: #6a8aaa;
    text-decoration: none;
  }

  /* Publications */
  .pub-row {
    display: grid;
    grid-template-columns: 3.5rem 1fr 5rem;
    gap: 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid #111a2a;
    align-items: baseline;
    transition: background 0.15s;
  }

  .pub-row:hover {
    background: #111a2a;
  }

  .pub-year {
    color: #4a6a8a;
    font-size: 0.75rem;
  }

  .pub-text {
    color: #b0b8c0;
    font-size: 0.8rem;
  }

  .pub-venue {
    color: #d4a574;
    font-size: 0.7rem;
    text-align: right;
    letter-spacing: 0.05em;
  }

  /* Teaching */
  .teaching-row {
    display: grid;
    grid-template-columns: 3.5rem 1fr 6rem;
    gap: 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid #111a2a;
    align-items: baseline;
  }

  .teaching-inst {
    color: #d4a574;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
  }

  .teaching-course {
    color: #b0b8c0;
    font-size: 0.8rem;
  }

  .teaching-when {
    color: #4a6a8a;
    font-size: 0.75rem;
    text-align: right;
  }

  /* Responsive */
  @media (max-width: 700px) {
    .catalog-grid {
      grid-template-columns: 1fr;
    }
    .sidebar-photo {
      max-width: 160px;
    }
    .pub-row {
      grid-template-columns: 3rem 1fr;
    }
    .pub-venue {
      display: none;
    }
    .teaching-row {
      grid-template-columns: 3rem 1fr;
    }
    .teaching-when {
      display: none;
    }
  }
</style>
