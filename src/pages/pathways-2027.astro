---
import SiteLayout from "../layouts/SiteLayout.astro";

interface Mentor {
  name: string;
  website: string;
  websiteLabel?: string;
  additionalWebsites?: { label: string; url: string }[];
  video: string;
  videoLabel?: string;
  additionalVideos?: { label: string; url: string }[];
  area: string;
  projectBlurb?: {
    title: string;
    introduction: string;
    bigPicture: string;
    coreQuestion: string;
    activities: string[];
    skills: string[];
  };
  papers: { title: string; url: string }[];
  question?: string;
  work?: string;
  excitement?: string;
}

const mentors: Mentor[] = [
  {
    name: "Emily Aiken",
    website: "https://emilylaiken.github.io/",
    video: "https://www.youtube.com/watch?v=cnVzav_yws4",
    area: "Computational social science",
    papers: [
      {
        title: "On the Meta-Design of Allocation Problems",
        url: "https://arxiv.org/abs/2602.08786",
      },
      {
        title:
          "Machine learning and phone data can improve targeting of humanitarian aid",
        url: "https://www.nature.com/articles/s41586-022-04484-9",
      },
    ],
    question:
      "How can computational and design-oriented methods improve the design and delivery of development and humanitarian aid programs?",
    work: "Analyze and clean quantitative data, train machine learning models, and help design or run surveys, experiments, and user studies.",
    excitement:
      "Using data science methods to improve the efficiency of high-stakes humanitarian work.",
  },
  {
    name: "Alex Cloninger and Gal Mishne",
    website: "https://sites.google.com/ucsd.edu/alexandercloninger/home",
    websiteLabel: "Visit Alex Cloninger’s website",
    additionalWebsites: [
      {
        label: "Visit Gal Mishne’s website",
        url: "https://mishne.ucsd.edu/",
      },
    ],
    video: "https://www.youtube.com/watch?v=en0H14EyTuQ",
    videoLabel: "Watch a video about Alex Cloninger’s research",
    additionalVideos: [
      {
        label: "Watch a video about Gal Mishne’s research",
        url: "https://www.youtube.com/watch?v=yqBTER3fhzI",
      },
    ],
    area: "Machine learning theory, applied math",
    projectBlurb: {
      title:
        "Mapping How AI Learns — Visualizing the Hidden Geometry of Neural Networks",
      introduction:
        'This project explores what actually happens inside a neural network while it learns. Instead of treating an AI model as a "black box," students take mathematical snapshots of the network\'s internal activity during training and map how those internal representations evolve over time.',
      bigPicture:
        'When a neural network learns to recognize patterns, its hidden layers organize data into structured shapes. By saving these patterns at different stages of training, known as "neural artifacts", we can treat them like coordinates on a map. Watching how these points move over time reveals the "learning dynamics" of the network, showing the exact journey the AI takes from random initialization to accurate predictions. Understanding the geometry of learning gives us a diagnostic dashboard for AI.',
      coreQuestion:
        "Can the shape and movement of an AI's internal signals tell us when it actually understands a concept versus when it is just memorizing data?",
      activities: [
        "Collect snapshots: Train standard neural networks and save their internal layer outputs across different epochs to create a digital paper trail of the learning process.",
        "Build visual maps: Use simple visualization tools to compress complex, high-dimensional data into readable 2D and 3D maps.",
        "Track the journey: Connect the maps across epochs to trace the trajectories of different data classes as the network learns to separate them.",
        "Spot failures early: Compare the geometric shapes of healthy models against models that are overfitting or struggling, finding early warning signs of training failure.",
      ],
      skills: [
        "Practical Python programming using PyTorch and scikit-learn.",
        "Hands-on experience with data visualization and dimensionality reduction techniques.",
        "Intuitive understanding of linear algebra and geometry in modern machine learning.",
        "Core research habits: designing experiments, plotting trajectories, and interpreting model behavior.",
      ],
    },
    papers: [
      {
        title:
          "Linear optimal transport embedding: provable Wasserstein classification for certain rigid transformations and perturbations",
        url: "https://doi.org/10.1093/imaiai/iaac023",
      },
      {
        title:
          "A deep network construction that adapts to intrinsic dimensionality beyond the domain",
        url: "https://doi.org/10.1016/j.neunet.2021.06.004",
      },
      {
        title:
          "RATS: Unsupervised manifold learning using low-distortion alignment of tangent spaces",
        url: "https://www.biorxiv.org/content/10.1101/2024.10.31.621292v1.abstract",
      },
      {
        title: "Learning Cartesian Product Graphs with Laplacian Constraints",
        url: "https://proceedings.mlr.press/v238/shi24a.html",
      },
    ],
  },
  {
    name: "Haojian Jin",
    website: "https://www.haojianj.in/",
    video: "https://www.youtube.com/watch?v=x8301nQAw2M",
    area: "Human-computer interaction and data privacy",
    papers: [
      {
        title:
          "Redesigning Privacy with User Feedback: The Case of Zoom Attendee Attention Tracking",
        url: "https://www.haojianj.in/resource/pdf/zoomattention.pdf",
      },
    ],
    question:
      "How can we make privacy risk assessment more accessible and accurate?",
    work: "Design and refine multiple-choice questions for privacy assessments and run user studies.",
    excitement:
      "Turning complex privacy concepts into simple, understandable tools.",
  },
  {
    name: "Victor Minces",
    website: "https://www.victorminces.com/",
    video: "https://youtu.be/avxPIJmeePw?si=ZogIyw7h1OlzthSx",
    area: "Interactive applications for manipulating, learning about, and playing with sound",
    papers: [
      {
        title:
          "M-flow: A Flow-based Music Creation Platform Improves Underrepresented Children’s Attitudes toward Computer Programming",
        url: "https://dl.acm.org/doi/10.1145/3585088.3589383",
      },
    ],
    question:
      "How can we design applications that let people interact with digital sound in ways that improve their lives?",
    work: "Help create browser-based applications for manipulating and creating sound.",
    excitement: "Seeing children excited to play with and learn about sound.",
  },
  {
    name: "Benjamin Smarr",
    website: "https://smarr.ucsd.edu/",
    video: "https://www.youtube.com/watch?v=S-IjGrR7Kxg&t=431s",
    area: "Time series in health AI and human–AI health collaboration",
    papers: [
      {
        title:
          "General feature selection technique supporting sex-debiasing in chronic illness algorithms validated using wearable device data",
        url: "https://www.nature.com/articles/s44294-024-00041-z",
      },
      {
        title:
          "AI for precision medicine must keep non-random complexity in mind to support equity in outcomes",
        url: "https://ieeexplore.ieee.org/abstract/document/10678664",
      },
    ],
    question:
      "Can we support decision making informed by health data using AI?",
    work: "Learn statistical methods for dissecting time-series health data.",
    excitement:
      "How new data sources empower historically underserved populations.",
  },
  {
    name: "Yusu Wang",
    website: "https://yusu.belkin-wang.org/",
    video: "https://youtu.be/Dv56aOAZIhg?si=gb98R5uniP7-zjiy",
    area: "Geometric deep learning, generative AI, graph learning, and neural algorithmic reasoning",
    papers: [
      {
        title:
          "General and Efficient Steering of Unconditional Diffusion Models",
        url: "https://openreview.net/forum?id=TU63jmFEWN",
      },
      {
        title:
          "De-Coupled NeuroGF for Shortest Path Distance Approximations on Large Terrains",
        url: "https://openreview.net/forum?id=PfyyEeVzQW",
      },
      {
        title:
          "Effective Neural Approximations for Geometric Optimization Problems",
        url: "https://openreview.net/forum?id=i7LuLGc2mu",
      },
    ],
    question:
      "How do generative models form internal concepts, and how can that understanding steer them toward better outputs? Can neural networks learn generalizable algorithmic procedures, and how can classical algorithms be combined with machine learning?",
    work: "Run experiments with machine learning models, implement improvements to existing models, analyze results, and contribute to paper writing when appropriate.",
    excitement:
      "Understanding what drives the behavior of modern machine learning models and using those insights to design better, more robust, and safer models.",
  },
  {
    name: "Duncan Watson-Parris",
    website: "https://duncanwp.github.io/",
    video: "https://www.youtube.com/watch?v=i3C_fgRmoQU",
    area: "Machine learning for climate",
    papers: [
      {
        title:
          "ClimateBench v1.0: A Benchmark for Data-Driven Climate Projections",
        url: "https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2021MS002954",
      },
      {
        title:
          "FaIRGP: A Bayesian Energy Balance Model for Surface Temperatures Emulation",
        url: "https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2023MS003926",
      },
    ],
    question: "Can we use machine learning to better model climate physics?",
    work: "Build machine learning models of atmospheric physics, analyze results, and compare them with climate models.",
    excitement: "Thinking about new ways of modeling the Earth!",
  },
];

const cohortPhotos = [
  {
    src: "/pathways-2027/2026-cohort.jpg",
    alt: "The 2026 Pathways to Discovery cohort outside the Halıcıoğlu Data Science Institute",
    width: 1000,
    height: 750,
  },
  {
    src: "/pathways-2027/2026-research-presentation.jpg",
    alt: "A Pathways student presenting research to the 2026 cohort",
    width: 1000,
    height: 750,
  },
  {
    src: "/pathways-2027/2026-cohort-lunch.jpg",
    alt: "The 2026 Pathways cohort sharing a meal together",
    width: 1000,
    height: 750,
  },
  {
    src: "/pathways-2027/2026-final-presentation.jpg",
    alt: "A Pathways student sharing findings from a summer research project",
    width: 1000,
    height: 750,
  },
  {
    src: "/pathways-2027/2026-climate-presentation.jpg",
    alt: "A Pathways student presenting climate research to a mentor",
    width: 1000,
    height: 1333,
  },
];

const linkClass =
  "font-medium underline decoration-offblack/30 underline-offset-2 transition-colors hover:decoration-offblack hover:decoration-2";
---

<SiteLayout
  title="Pathways to Discovery 2027 – UC San Diego"
  description="Information about the 2027 Pathways to Discovery Program at UC San Diego's Halıcıoğlu Data Science Institute."
>
  <main class="mx-auto max-w-4xl px-4 pb-20">
    <header class="border-b border-offblack/20 pb-10 sm:pb-12">
      <h1
        class="text-4xl leading-[1.05] font-semibold tracking-tight sm:text-6xl"
      >
        Pathways to Discovery 2027
      </h1>
      <p class="mt-6 text-lg leading-relaxed sm:text-xl">
        Calling undergraduate and master’s students at Prairie View A&amp;M
        University and Morgan State University! Interested in AI research? Join
        us in Summer 2027 at UC San Diego for a paid summer research internship.
      </p>

      <a
        class="mt-8 inline-flex items-center gap-3 border border-offblack/25 px-4 py-3 text-sm font-semibold transition-colors hover:bg-offblack/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-offblack"
        href="https://forms.gle/dS6ZgqFXhFkQTdw9A"
        target="_blank"
        rel="noreferrer"
      >
        <span class="text-base" aria-hidden="true">👉</span>
        Applications due September 30, 2026. Click here to apply!
      </a>

      <div
        class="mt-10 flex items-center gap-6"
        aria-label="Program partner institutions"
      >
        <a
          class="w-64 min-w-0 shrink transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-offblack"
          href="https://datascience.ucsd.edu/"
          target="_blank"
          rel="noreferrer"
        >
          <img
            class="max-h-15 w-full object-contain object-left"
            src="/logos/hdsi.svg"
            alt="UC San Diego Halıcıoğlu Data Science Institute"
            width="612"
            height="140"
          />
        </a>
        <a
          class="shrink-0 transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-offblack"
          href="https://www.pvamu.edu/"
          target="_blank"
          rel="noreferrer"
        >
          <img
            class="size-20 object-contain"
            src="/logos/pvamu.png"
            alt="Prairie View A&M University"
            width="239"
            height="229"
          />
        </a>
        <a
          class="flex size-20 shrink-0 items-center justify-center bg-[#1b4383] p-2 transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-offblack"
          href="https://www.morgan.edu/"
          target="_blank"
          rel="noreferrer"
        >
          <img
            class="max-h-16 w-full object-contain"
            src="/logos/morgan-state.png"
            alt="Morgan State University"
            width="172"
            height="174"
          />
        </a>
      </div>
    </header>

    <div class="mt-10 grid gap-12 sm:mt-14 sm:grid-cols-[minmax(0,1fr)_10rem]">
      <div class="space-y-14">
        <section aria-labelledby="about-heading">
          <h2 id="about-heading" class="text-2xl font-semibold tracking-tight">
            Why apply?
          </h2>
          <p class="mt-4 leading-relaxed">
            Some of best jobs in the world are in AI research. Think jobs like <a
              href="https://openai.com/careers/research-scientist-san-francisco/"
              class={linkClass}
              target="_blank">Research Scientist at OpenAI</a
            >, or becoming a university faculty studying AI. To get these jobs,
            you need to have a strong track record of research in AI, which
            often means getting a PhD. To get into a top PhD program, you'll
            want to have experience doing AI research. That's where this program
            comes in!
          </p>
          <p class="mt-4 leading-relaxed">
            As a research intern in Pathways to Discovery, you will:
            <ul class="mt-4 list-disc space-y-2 pl-5 marker:text-offblack/50">
              <li>
                Get hands-on experience doing cutting-edge AI research at UC San
                Diego, <a
                  href="https://csrankings.org/"
                  class={linkClass}
                  target="_blank"
                  >a top-5 institution in the world in computer science and AI</a
                >.
              </li>
              <li>
                Work with world-class professors, researchers, and graduate
                students.
              </li>
              <li>
                Live on{" "}
                <a
                  href="https://www.google.com/search?q=living%20at%20uc%20san%20diego&udf=257&udm=2"
                  class={linkClass}
                  target="_blank">the beautiful UCSD campus</a
                > for 8 weeks during Summer 2027.
              </li>
              <li>
                Gain an advantage when applying to PhD programs, especially at
                the University of California campuses.
              </li>
              <li>Get paid while doing so!</li>
            </ul>
          </p>
        </section>

        <section id="eligibility" aria-labelledby="eligibility-heading">
          <h2
            id="eligibility-heading"
            class="text-2xl font-semibold tracking-tight"
          >
            Eligibility
          </h2>
          <ul class="mt-4 list-disc space-y-2 pl-5 marker:text-offblack/50">
            <li>
              Open to undergraduate and master’s students from Prairie View
              A&amp;M University and Morgan State University.
            </li>
            <li>
              Students should have some coursework or experience in data
              science, computer science, statistics, or a related field.
            </li>
            <li>Prior research experience is a plus, but not required.</li>
            <li>International students are eligible.</li>
            <li>
              Graduating seniors are eligible (e.g. you will not be a student
              during Fall 2027).
            </li>
          </ul>
        </section>

        <section id="funding" aria-labelledby="funding-heading">
          <h2
            id="funding-heading"
            class="text-2xl font-semibold tracking-tight"
          >
            Funding and support
          </h2>
          <p class="mt-4">Interns selected for the program will receive:</p>
          <ul class="mt-3 list-disc space-y-2 pl-5 marker:text-offblack/50">
            <li>A paid summer research fellowship with a $5,000 stipend.</li>
            <li>Fully covered on-campus housing and dining.</li>
            <li>Round-trip travel to UC San Diego.</li>
            <li>
              Mentorship, networking, and career development opportunities.
            </li>
            <li>Field trips to the San Diego Zoo, beaches, and more.</li>
          </ul>
        </section>

        <section id="timeline" aria-labelledby="timeline-heading">
          <h2
            id="timeline-heading"
            class="text-2xl font-semibold tracking-tight"
          >
            Timeline
          </h2>
          <dl
            class="mt-4 divide-y divide-offblack/15 border-y border-offblack/15"
          >
            <div class="grid gap-1 py-3 sm:grid-cols-[12rem_1fr]">
              <dt class="font-medium">Applications due</dt>
              <dd>
                September 30, 2026, <a
                  class={linkClass}
                  href="https://en.wikipedia.org/wiki/Anywhere_on_Earth"
                  target="_blank">Anywhere on Earth</a
                >
              </dd>
            </div>
            <div class="grid gap-1 py-3 sm:grid-cols-[12rem_1fr]">
              <dt class="font-medium">Acceptance notification</dt>
              <dd>October 31, 2026</dd>
            </div>
            <div class="grid gap-1 py-3 sm:grid-cols-[12rem_1fr]">
              <dt class="font-medium">Program dates</dt>
              <dd>
                June 20, 2027 - August 14, 2027 (tentative, exact dates to be
                announced)
              </dd>
            </div>
          </dl>
        </section>

        <section id="mentors" aria-labelledby="mentors-heading">
          <h2
            id="mentors-heading"
            class="text-2xl font-semibold tracking-tight"
          >
            Mentors and projects
          </h2>
          <p class="mt-4 leading-relaxed">
            Explore the potential research projects below. Mentors are listed in
            alphabetical order by last name.
          </p>

          <div
            class="mt-7 divide-y divide-offblack/20 border-y border-offblack/20"
          >
            {
              mentors.map((mentor, index) => (
                <details class="group py-5" open={index === 0}>
                  <summary class="flex cursor-pointer list-none items-start gap-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-offblack [&::-webkit-details-marker]:hidden">
                    <span class="min-w-0 flex-1">
                      <span class="block text-lg font-semibold">
                        {mentor.name}
                      </span>
                      <span class="mt-0.5 block text-sm text-offblack/70">
                        {mentor.area}
                      </span>
                    </span>
                    <span
                      class="mt-1 text-xl leading-none transition-transform group-open:rotate-45"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  </summary>

                  <div class="mt-6 space-y-5 text-sm leading-relaxed">
                    <div class="space-y-1">
                      <p>
                        <a
                          class={linkClass}
                          href={mentor.website}
                          target="_blank"
                          rel="noreferrer"
                        >
                          {mentor.websiteLabel ??
                            `Visit ${mentor.name}’s website`}
                        </a>
                      </p>
                      {mentor.additionalWebsites?.map((website) => (
                        <p>
                          <a
                            class={linkClass}
                            href={website.url}
                            target="_blank"
                            rel="noreferrer"
                          >
                            {website.label}
                          </a>
                        </p>
                      ))}
                      <p>
                        <a
                          class={linkClass}
                          href={mentor.video}
                          target="_blank"
                          rel="noreferrer"
                        >
                          {mentor.videoLabel ??
                            "Watch a video about this professor's research"}
                        </a>
                      </p>
                      {mentor.additionalVideos?.map((video) => (
                        <p>
                          <a
                            class={linkClass}
                            href={video.url}
                            target="_blank"
                            rel="noreferrer"
                          >
                            {video.label}
                          </a>
                        </p>
                      ))}
                    </div>

                    {mentor.projectBlurb ? (
                      <div class="space-y-5">
                        <p>
                          <strong>Project Title:</strong>{" "}
                          {mentor.projectBlurb.title}
                        </p>

                        <p>{mentor.projectBlurb.introduction}</p>

                        <p>
                          <strong>Big Picture:</strong>{" "}
                          {mentor.projectBlurb.bigPicture}
                        </p>

                        <p>
                          <strong>Core question:</strong>{" "}
                          {mentor.projectBlurb.coreQuestion}
                        </p>

                        <div>
                          <p>
                            <strong>What students will do:</strong>
                          </p>
                          <ul class="mt-1 list-disc space-y-1 pl-5">
                            {mentor.projectBlurb.activities.map((activity) => (
                              <li>{activity}</li>
                            ))}
                          </ul>
                        </div>

                        <div>
                          <p>
                            <strong>Skills students will gain:</strong>
                          </p>
                          <ul class="mt-1 list-disc space-y-1 pl-5">
                            {mentor.projectBlurb.skills.map((skill) => (
                              <li>{skill}</li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    ) : (
                      <>
                        <div>
                          <h3 class="font-semibold">Main research question</h3>
                          <p class="mt-1">{mentor.question}</p>
                        </div>

                        <div>
                          <h3 class="font-semibold">
                            What a summer intern will do
                          </h3>
                          <p class="mt-1">{mentor.work}</p>
                        </div>

                        <div>
                          <h3 class="font-semibold">What excites the lab</h3>
                          <p class="mt-1">{mentor.excitement}</p>
                        </div>
                      </>
                    )}

                    <div>
                      <h3 class="font-semibold">Selected papers</h3>
                      <ul class="mt-1 list-disc space-y-1 pl-5">
                        {mentor.papers.map((paper) => (
                          <li>
                            <a
                              class={linkClass}
                              href={paper.url}
                              target="_blank"
                              rel="noreferrer"
                            >
                              {paper.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </details>
              ))
            }
          </div>
        </section>
      </div>

      <aside class="hidden sm:block">
        <nav class="sticky top-6 text-sm" aria-label="Page sections">
          <p class="mb-3 text-xs font-semibold tracking-widest uppercase">
            On this page
          </p>
          <ol class="space-y-2 border-l border-offblack/25 pl-4">
            <li>
              <a class="hover:underline" href="#eligibility">Eligibility</a>
            </li>
            <li><a class="hover:underline" href="#funding">Funding</a></li>
            <li><a class="hover:underline" href="#timeline">Timeline</a></li>
            <li><a class="hover:underline" href="#mentors">Mentors</a></li>
            <li>
              <a class="hover:underline" href="#past-cohorts">Past cohorts</a>
            </li>
            <li>
              <a class="hover:underline" href="#acknowledgements">
                Acknowledgements
              </a>
            </li>
          </ol>
        </nav>
      </aside>
    </div>

    <section
      id="past-cohorts"
      class="mt-14 sm:mt-20"
      aria-labelledby="past-cohorts-heading"
    >
      <h2
        id="past-cohorts-heading"
        class="text-2xl font-semibold tracking-tight"
      >
        Past cohorts
      </h2>
      <p class="mt-4 max-w-2xl leading-relaxed">
        In 2026, we successfully ran Pathways to Discovery for the first time,
        bringing students and mentors together at UC San Diego for a summer of
        research, learning, and community.
      </p>

      <div class="mt-7 columns-1 gap-4 sm:columns-2">
        {
          cohortPhotos.map((photo) => (
            <img
              class="mb-4 block w-full break-inside-avoid"
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="lazy"
              decoding="async"
            />
          ))
        }
      </div>
    </section>

    <section
      id="acknowledgements"
      class="mt-14 border-t border-offblack/20 pt-10 sm:mt-20"
      aria-labelledby="acknowledgements-heading"
    >
      <h2
        id="acknowledgements-heading"
        class="text-2xl font-semibold tracking-tight"
      >
        Acknowledgements
      </h2>
      <p class="mt-4 leading-relaxed">
        This program is generously funded by the <a
          class={linkClass}
          href="https://www.ucop.edu/uc-hbcu-initiative/index.html"
          target="_blank"
          rel="noreferrer">UC-HBCU Initiative</a
        >.
      </p>
    </section>
  </main>
</SiteLayout>
