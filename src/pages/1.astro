---
import "../styles/global.css";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sam Lau — UC San Diego</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet" />
</head>
<body class="broadsheet-body">
  <div class="broadsheet-page">
    <!-- Masthead -->
    <header class="broadsheet-masthead">
      <div class="masthead-rule"></div>
      <div class="masthead-dateline">Halıcıoğlu Data Science Institute · UC San Diego</div>
      <h1 class="masthead-name">Sam Lau</h1>
      <div class="masthead-title">Assistant Teaching Professor</div>
      <div class="masthead-rule"></div>
      <nav class="masthead-nav">
        <a href="mailto:lau@ucsd.edu">lau@ucsd.edu</a>
        <span class="nav-dot">·</span>
        <a href="https://github.com/samlau95">GitHub</a>
        <span class="nav-dot">·</span>
        <a href="https://twitter.com/samlau95">@samlau95</a>
        <span class="nav-dot">·</span>
        <a href="/cv">CV</a>
        <span class="nav-dot">·</span>
        <a href="https://dstl-lab.github.io/">DSTL Lab</a>
      </nav>
    </header>

    <!-- Lead Section: Photo + Bio + Projects -->
    <div class="broadsheet-lead">
      <div class="lead-photo">
        <img src="/sam_lau_headshot_small.JPG" alt="Sam Lau" />
      </div>
      <div class="lead-rule"></div>
      <div class="lead-content">
        <p class="lead-lede">
          Sam Lau applies methods from human-computer interaction to design
          software tools for education. He authored <em>Learning Data Science</em>,
          published by O'Reilly Media in 2023.
        </p>
        <h2 class="section-hed">Projects</h2>
        <p>
          <strong><a href="https://pandastutor.com/">Pandas Tutor</a></strong> — Makes
          step-by-step diagrams showing how Python pandas code transforms data.
          <a href="https://www.youtube.com/watch?v=_vPmMYSGAlU" class="inline-link">[podcast]</a>
        </p>
        <h2 class="section-hed">News</h2>
        <p>
          Attending SIGCSE 2026 with sessions on teaching CS with AI and student
          presentations on skill tests and practice problems.
        </p>
      </div>
    </div>

    <!-- Publications -->
    <div class="broadsheet-section">
      <h2 class="section-banner">Selected Publications</h2>
      <div class="pub-columns">
        <ol class="pub-list">
          <li>Barriers that Programming Instructors Face While Performing Emergency Pedagogical Design to Shape Student-AI Interactions with Generative AI Tools. <span class="pub-venue">CHI 2026</span></li>
          <li>Improving LLM-Generated Educational Content. <span class="pub-venue">SIGCSE 2026</span></li>
          <li>Designing and Implementing Skill Tests at Scale. <span class="pub-venue">SIGCSE 2026</span></li>
          <li>The Design Space of LLM-Based AI Coding Assistants. <span class="pub-venue">VL/HCC 2025</span></li>
          <li>"I'm not sure, but…": Expert Practices. <span class="pub-venue">SIGCSE 2025</span></li>
          <li>How Novices Use Program Visualizations. <span class="pub-venue">SIGCSE 2025</span></li>
          <li>Beyond the Hype: Generative AI Review. <span class="pub-venue">ITiCSE 2025</span></li>
          <li>From Ban It Till We Understand It. <span class="pub-venue">ICER 2023</span></li>
          <li>Teaching Data Science by Visualizing Data Table Transformations. <span class="pub-venue">DataEd 2023</span></li>
          <li>Codehound: Helping Instructors Track Pedagogical Code Dependencies. <span class="pub-venue">SPLASH-E 2022</span></li>
          <li>The Challenges of Evolving Technical Courses at Scale. <span class="pub-venue">L@S 2022</span></li>
          <li>How Computer Science and Statistics Instructors Approach Data Science. <span class="pub-venue">SIGCSE 2022</span></li>
          <li>TweakIt: Supporting End-User Programmers. <span class="pub-venue">CHI 2021</span></li>
          <li>The Design Space of Computational Notebooks. <span class="pub-venue">VL/HCC 2020</span></li>
          <li>Data Theater: Live Programming Environment. <span class="pub-venue">LIVE 2020</span></li>
          <li>Experiment Reconstruction Reduces Fixation. <span class="pub-venue">C&amp;C 2019</span></li>
        </ol>
      </div>
    </div>

    <!-- Teaching -->
    <div class="broadsheet-section">
      <h2 class="section-banner">Teaching</h2>
      <div class="teaching-grid">
        <div>
          <h3 class="teaching-school">UC San Diego</h3>
          <p><strong>DSC 80</strong> Practice and Application of Data Science <span class="teaching-terms">Fall 2024, Spring 2024, Fall 2023</span></p>
          <p><strong>DSC 106</strong> Data Visualization <span class="teaching-terms">Winter 2024</span></p>
        </div>
        <div>
          <h3 class="teaching-school">UC Berkeley</h3>
          <p><strong>Data 100</strong> Principles and Techniques of Data Science <span class="teaching-terms">Summer 2019</span></p>
          <p><strong>Data 8</strong> Foundations of Data Science <span class="teaching-terms">Summer 2017</span></p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>

<style>
  .broadsheet-body {
    background: #f4f1eb;
    color: #1a1a1a;
    font-family: 'Source Serif 4', Georgia, serif;
    line-height: 1.6;
  }

  .broadsheet-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
    animation: fadeUp 0.6s ease-out both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Masthead */
  .broadsheet-masthead {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .masthead-rule {
    height: 4px;
    background: #1a1a1a;
    border-top: 1px solid #1a1a1a;
    border-bottom: 1px solid #1a1a1a;
    background: repeating-linear-gradient(
      transparent 0px, transparent 1px,
      #1a1a1a 1px, #1a1a1a 2px,
      transparent 2px, transparent 3px,
      #1a1a1a 3px, #1a1a1a 4px
    );
    margin-bottom: 0.75rem;
  }

  .masthead-dateline {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 0.25rem;
  }

  .masthead-name {
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: clamp(3rem, 8vw, 5rem);
    line-height: 1;
    margin: 0.15em 0;
    letter-spacing: -0.02em;
  }

  .masthead-title {
    font-style: italic;
    font-size: 1.15rem;
    color: #444;
    margin-bottom: 0.75rem;
  }

  .masthead-nav {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .masthead-nav a {
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .nav-dot { color: #999; }

  /* Lead */
  .broadsheet-lead {
    display: grid;
    grid-template-columns: 200px 1px 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .lead-photo img {
    width: 100%;
    filter: grayscale(100%) contrast(1.1);
  }

  .lead-rule {
    background: #1a1a1a;
  }

  .lead-lede {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .lead-content p {
    margin-bottom: 0.5rem;
  }

  .lead-content a {
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .inline-link {
    font-size: 0.85rem;
    color: #555 !important;
  }

  /* Sections */
  .section-hed {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid #1a1a1a;
    padding-bottom: 0.15rem;
    display: inline-block;
  }

  .section-banner {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    font-weight: 700;
    text-align: center;
    padding: 0.35rem 0;
    border-top: 2px solid #1a1a1a;
    border-bottom: 1px solid #1a1a1a;
    margin-bottom: 1.25rem;
    letter-spacing: 0.04em;
  }

  .broadsheet-section {
    margin-bottom: 2.5rem;
  }

  /* Publications */
  .pub-columns {
    columns: 2;
    column-gap: 2.5rem;
    column-rule: 1px solid #ccc;
  }

  .pub-list {
    font-size: 0.88rem;
    line-height: 1.55;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pub-list li {
    margin-bottom: 0.65rem;
    break-inside: avoid;
    padding-left: 1.8rem;
    position: relative;
  }

  .pub-list li::before {
    content: counter(list-item, decimal) ".";
    position: absolute;
    left: 0;
    color: #888;
    font-size: 0.8rem;
  }

  .pub-venue {
    font-style: italic;
    color: #666;
  }

  /* Teaching */
  .teaching-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    font-size: 0.9rem;
  }

  .teaching-school {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .teaching-grid p {
    margin-bottom: 0.35rem;
  }

  .teaching-terms {
    color: #777;
    font-style: italic;
    font-size: 0.82rem;
  }

  /* Responsive */
  @media (max-width: 700px) {
    .broadsheet-lead {
      grid-template-columns: 1fr;
    }
    .lead-photo img {
      max-width: 180px;
    }
    .lead-rule {
      display: none;
    }
    .pub-columns {
      columns: 1;
    }
    .teaching-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
