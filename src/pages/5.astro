---
import "../styles/global.css";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sam Lau — UC San Diego</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;1,7..72,400&display=swap" rel="stylesheet" />
</head>
<body class="tufte-body">
  <article class="tufte-article">
    <!-- Header -->
    <header class="tufte-header">
      <h1 class="tufte-name">Sam Lau</h1>
      <p class="tufte-subtitle">
        Assistant Teaching Professor · Halıcıoğlu Data Science Institute · UC San Diego
      </p>
    </header>

    <!-- Bio with margin note photo -->
    <section class="tufte-section">
      <p class="tufte-lead">
        <span class="margin-note margin-photo">
          <img src="/sam_lau_headshot_small.JPG" alt="Sam Lau" />
          <span class="margin-caption">
            <a href="mailto:lau@ucsd.edu">lau@ucsd.edu</a><br/>
            <a href="https://github.com/samlau95">GitHub</a> ·
            <a href="https://twitter.com/samlau95">Twitter</a><br/>
            <a href="/cv">CV</a> ·
            <a href="https://dstl-lab.github.io/">DSTL Lab</a>
          </span>
        </span>
        Sam Lau applies methods from human-computer interaction to design
        software tools for education. He authored <em>Learning Data Science</em>,
        published by O'Reilly Media in 2023.
      </p>
    </section>

    <hr class="tufte-hr" />

    <!-- Projects -->
    <section class="tufte-section">
      <h2 class="tufte-h2">Projects</h2>
      <p>
        <span class="margin-note">
          <a href="https://www.youtube.com/watch?v=_vPmMYSGAlU">Listen to the podcast episode about Pandas Tutor →</a>
        </span>
        <strong><a href="https://pandastutor.com/" class="tufte-link">Pandas Tutor</a></strong>
        makes step-by-step diagrams showing how Python pandas code transforms
        data. It helps students understand data transformations by visualizing
        each operation.
      </p>
    </section>

    <hr class="tufte-hr" />

    <!-- News -->
    <section class="tufte-section">
      <h2 class="tufte-h2">News</h2>
      <p>
        Attending SIGCSE 2026 with sessions on teaching CS with AI and student
        presentations on skill tests and practice problems.
      </p>
    </section>

    <hr class="tufte-hr" />

    <!-- Publications -->
    <section class="tufte-section">
      <h2 class="tufte-h2">Publications</h2>

      <div class="pub-year-group">
        <h3 class="pub-year-label">2026</h3>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">CHI 2026</span>
          Barriers that Programming Instructors Face While Performing Emergency Pedagogical Design to Shape Student-AI Interactions with Generative AI Tools.
        </p>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">SIGCSE 2026</span>
          Improving LLM-Generated Educational Content.
        </p>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">SIGCSE 2026</span>
          Designing and Implementing Skill Tests at Scale.
        </p>
      </div>

      <div class="pub-year-group">
        <h3 class="pub-year-label">2025</h3>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">VL/HCC 2025</span>
          The Design Space of LLM-Based AI Coding Assistants.
        </p>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">SIGCSE 2025</span>
          "I'm not sure, but…": Expert Practices.
        </p>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">SIGCSE 2025</span>
          How Novices Use Program Visualizations.
        </p>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">ITiCSE 2025</span>
          Beyond the Hype: Generative AI Review.
        </p>
      </div>

      <div class="pub-year-group">
        <h3 class="pub-year-label">2023</h3>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">ICER 2023</span>
          From Ban It Till We Understand It.
        </p>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">DataEd 2023</span>
          Teaching Data Science by Visualizing Data Table Transformations.
        </p>
      </div>

      <div class="pub-year-group">
        <h3 class="pub-year-label">2022</h3>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">SPLASH-E 2022</span>
          Codehound: Helping Instructors Track Pedagogical Code Dependencies.
        </p>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">L@S 2022</span>
          The Challenges of Evolving Technical Courses at Scale.
        </p>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">SIGCSE 2022</span>
          How Computer Science and Statistics Instructors Approach Data Science.
        </p>
      </div>

      <div class="pub-year-group">
        <h3 class="pub-year-label">2021</h3>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">CHI 2021</span>
          TweakIt: Supporting End-User Programmers.
        </p>
      </div>

      <div class="pub-year-group">
        <h3 class="pub-year-label">2020</h3>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">VL/HCC 2020</span>
          The Design Space of Computational Notebooks.
        </p>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">LIVE 2020</span>
          Data Theater: Live Programming Environment.
        </p>
      </div>

      <div class="pub-year-group">
        <h3 class="pub-year-label">2019</h3>
        <p class="pub-entry">
          <span class="margin-note pub-venue-note">C&amp;C 2019</span>
          Experiment Reconstruction Reduces Fixation.
        </p>
      </div>
    </section>

    <hr class="tufte-hr" />

    <!-- Teaching -->
    <section class="tufte-section">
      <h2 class="tufte-h2">Teaching</h2>

      <h3 class="teaching-inst">UC San Diego</h3>
      <p class="teaching-entry">
        <span class="margin-note teaching-terms-note">Fall 2024, Spring 2024, Fall 2023</span>
        <strong>DSC 80</strong> — Practice and Application of Data Science
      </p>
      <p class="teaching-entry">
        <span class="margin-note teaching-terms-note">Winter 2024</span>
        <strong>DSC 106</strong> — Data Visualization
      </p>

      <h3 class="teaching-inst">UC Berkeley</h3>
      <p class="teaching-entry">
        <span class="margin-note teaching-terms-note">Summer 2019</span>
        <strong>Data 100</strong> — Principles and Techniques of Data Science
      </p>
      <p class="teaching-entry">
        <span class="margin-note teaching-terms-note">Summer 2017</span>
        <strong>Data 8</strong> — Foundations of Data Science
      </p>
    </section>
  </article>
</body>
</html>

<style>
  .tufte-body {
    background: #fffff8;
    color: #111;
    font-family: 'Literata', Georgia, serif;
    font-size: 1rem;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }

  .tufte-article {
    width: 87.5%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 0 6rem;
    counter-reset: sidenote-counter;
    animation: tufteFade 0.6s ease-out both;
  }

  @keyframes tufteFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Header */
  .tufte-header {
    margin-bottom: 3rem;
    padding-left: 5%;
    max-width: 55%;
  }

  .tufte-name {
    font-size: clamp(2.5rem, 5vw, 3.8rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .tufte-subtitle {
    font-size: 0.95rem;
    color: #555;
    font-style: italic;
  }

  /* Sections */
  .tufte-section {
    padding-left: 5%;
    width: 55%;
    position: relative;
  }

  .tufte-h2 {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    margin-top: 0;
  }

  .tufte-hr {
    border: none;
    border-top: 1px solid #ddd;
    width: 55%;
    margin: 2.5rem 0 2.5rem 5%;
  }

  /* Margin notes */
  .margin-note {
    float: right;
    clear: right;
    margin-right: -60%;
    width: 50%;
    font-size: 0.82rem;
    line-height: 1.5;
    color: #666;
    position: relative;
  }

  .margin-photo {
    margin-top: 0;
  }

  .margin-photo img {
    width: 100%;
    max-width: 200px;
    display: block;
    margin-bottom: 0.5rem;
  }

  .margin-caption {
    display: block;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .margin-caption a {
    color: #2a4494;
    text-decoration: none;
  }

  .margin-caption a:hover {
    text-decoration: underline;
  }

  /* Lead text */
  .tufte-lead {
    font-size: 1.05rem;
  }

  .tufte-lead em {
    color: #2a4494;
  }

  /* Links */
  .tufte-link {
    color: #111;
    text-decoration: none;
    border-bottom: 1px solid #2a4494;
    padding-bottom: 1px;
  }

  .tufte-link:hover {
    color: #2a4494;
  }

  .tufte-section a {
    color: #2a4494;
    text-decoration: none;
  }

  .tufte-section a:hover {
    text-decoration: underline;
  }

  /* Publications */
  .pub-year-group {
    margin-bottom: 1.25rem;
  }

  .pub-year-label {
    font-size: 1rem;
    font-weight: 600;
    color: #2a4494;
    margin-bottom: 0.25rem;
    margin-top: 0;
  }

  .pub-entry {
    margin-bottom: 0.5rem;
    font-size: 0.92rem;
  }

  .pub-venue-note {
    font-size: 0.75rem;
    color: #888;
    letter-spacing: 0.02em;
  }

  /* Teaching */
  .teaching-inst {
    font-size: 1rem;
    font-weight: 600;
    margin-top: 1rem;
    margin-bottom: 0.35rem;
  }

  .teaching-entry {
    margin-bottom: 0.5rem;
    font-size: 0.92rem;
  }

  .teaching-terms-note {
    font-size: 0.75rem;
    color: #888;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .tufte-header {
      max-width: 90%;
    }
    .tufte-section {
      width: 90%;
    }
    .tufte-hr {
      width: 90%;
    }
    .margin-note {
      float: none;
      display: block;
      margin: 0.5rem 0 0.75rem;
      width: 100%;
      padding: 0.5rem 0.75rem;
      background: #f8f8f4;
      border-left: 2px solid #ddd;
    }
    .margin-photo {
      display: flex;
      gap: 1rem;
      align-items: start;
    }
    .margin-photo img {
      max-width: 120px;
    }
  }
</style>
